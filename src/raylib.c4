struct Color{
    u8 red
    u8 green
    u8 blue
    u8 alpha
}

impl Color{
    fn init(u8 red,u8 green,u8 blue,u8 alpha){
        self->red   = red
        self->green = green
        self->blue  = blue
        self->alpha = alpha
    }

    #[static(true)]
    fn new(u8 red,u8 green,u8 blue,u8 alpha)->Color{
        Color color
        color.init(red,green,blue,alpha)
        return color
    }
}

fn GREEN()->Color{
    return Color::new(0, 228, 48, 255)
}


struct AudioStream{
    void *buffer
    void *processor
    u32 sampleRate
    u32 sampleSize
    u32 channels
}


struct Sound{
    AudioStream stream
    u32 frameCount
}


struct Music{
    AudioStream stream
    u32 frameCount
    bool looping
    i32 ctxType
    void *ctcData
}

struct Rectangle{
    f32 x
    f32 y
    f32 width
    f32 height
}


impl Rectangle{
    fn init(f32 x,f32 y,f32 width,f32 height){
        self->x      = x
        self->y      = y
        self->width  = width
        self->height = height
    }

    #[static(true)]
    fn new(f32 x,f32 y,f32 width,f32 height)->Rectangle{
        Rectangle node
        node.init(x,y,width,height)
        return node
    }
}


struct Vector2{
    f32 x
    f32 y
}

impl Vector2{
    fn init(f32 x,f32 y){
        self->x = x
        self->y = y
    }

    #[static(true)]
    fn new(f32 x,f32 y)->Vector2{
        Vector2 node
        node.init(x,y)
        return node
    }

    fn get_x()->f32{
        return self->x
    }

    fn get_y()->f32{
        return self->y
    }
}


foreign "C"{
    fn InitWindow(i32 width,i32 height,str title)
    fn CloseWindow()
    fn WindowShouldClose()->i32
    fn BeginDrawing()
    fn EndDrawing()
    fn ClearBackground(Color color)


    fn DrawRectangle(i32 x,i32 y,i32 width,i32 height,Color color)
    fn DrawRectanglePro(Rectangle rectangle,Vector2 origin,f32 rotation,Color color)

    fn IsKeyDown(i32 key)->bool
    fn IsKeyUp(i32 key)->bool
    fn IsKeyPressed(i32 key)->bool
    fn IsKeyPressedRepeat(i32 key)->bool
    fn IsKeyReleased(i32 key)->bool

    fn GetFrameTime()->f32

    fn SetTargetFPS(i32 fps)


    fn InitAudioDevice()
    fn CloseAudioDevice()

    fn LoadSound(const char *fileName)->Sound
    fn PlaySound(Sound sound)

    fn LoadMusicStream(str fileName)->Music
    fn PlayMusicStream(Music music)
    fn UpdateMusicStream(Music music)
    fn StopMusicStream(Music music)
    fn PauseMusicStream(Music music)
    fn ResumeMusicStream(Music music)
    fn UnloadMusicStream(Music music)
}

fn init_window(i32 width,i32 height,str title){
    return InitWindow(width,height,title)
}

fn close_window(){
    return CloseWindow()
}


fn window_should_close()->i32{
    return WindowShouldClose()
}

fn begin_drawing(){
    return BeginDrawing()
}

fn end_drawing(){
    return EndDrawing()
}


fn clear_background(Color color){
    return ClearBackground(color)
}



fn draw_rectangle(i32 x,i32 y,i32 width,i32 height,Color color){
    return DrawRectangle(x,y,width,height,color)
}






fn is_key_down(i32 key)->bool{
    return IsKeyDown(key)
}


fn is_key_up(i32 key)->bool{
    return IsKeyUp(key)
}


fn is_key_pressed(i32 key)->bool{
    return IsKeyPressed(key)
}


fn is_key_pressed_repeat(i32 key)->bool{
    return IsKeyPressedRepeat(key)
}

fn is_key_released(i32 key)->bool{
    return IsKeyReleased(key)
}




fn get_frame_time()->f32{
    return GetFrameTime()
}


fn set_target_fps(i32 framePerSecond){
    return SetTargetFPS(framePerSecond)
}


fn init_audio_device(){
    return InitAudioDevice()
}

fn close_audio_device(){
    return CloseAudioDevice()
}


fn load_sound(const char *fileName)->Sound{
    return LoadSound(fileName)
}


fn play_sound(Sound sound){
    return PlaySound(sound)
}

fn load_music_stream(str fileName)->Music{
    return LoadMusicStream(fileName)
}


fn play_music_stream(Music music){
    return PlayMusicStream(music)
}

fn update_music_stream(Music music){
    return UpdateMusicStream(music)
}

fn stop_music_stream(Music music){
    return StopMusicStream(music)
}


fn pause_music_stream(Music music){
    return PauseMusicStream(music)
}


fn resume_music_stream(Music music){
    return ResumeMusicStream(music)
}


fn unload_music_stream(Music music){
    return UnloadMusicStream(music)
}



fn draw_rectangle_pro(Rectangle rectangle,Vector2 origin,f32 rotation,Color color){
    return DrawRectanglePro(rectangle,origin,rotation,color)
}

