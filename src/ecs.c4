struct Vec2{
    f32 x
    f32 y
}

impl Vec2{
    fn init(f32 x,f32 y){
        self->x = x
        self->y = y
    }

    #[static(true)]
    fn new(f32 x,f32 y)->Vec2{
        Vec2 node
        node.init(x,y)
        return node
    }

    fn get_x()->f32{
        return self->x
    }

    fn get_y()->f32{
        return self->y
    }
}


struct Transform{
    Vec2 position
    Vec2 velocity
    f32 angle
}



impl Transform{
    fn init(Vec2 position,Vec2 velocity,f32 angle){
        self->position = position
        self->velocity = velocity
        self->angle    = angle
    }
    

    #[static(true)]
    fn new(Vec2 position,Vec2 velocity,f32 angle)->Transform{
        Transform node
        node.init(position,velocity,angle)
        return node
    }

    fn get_position()->Vec2{
        return self->position
    }


    fn get_velocity()->Vec2{
        return self->velocity
    }

    fn get_angle()->f32{
        return self->angle
    }
}



struct Shape{
    f32 radius
    i32 sides
    Color fill
    Color outline
    f32 thickness
}


impl Shape{
    fn init(f32 radius,i32 sides,Color fill,Color outline,f32 thickness){
        self->radius    = radius
        self->sides     = sides
        self->fill      = fill
        self->outline   = outline
        self->thickness = thickness
    }

    #[static(true)]
    fn new(f32 radius,i32 sides,Color fill,Color outline,f32 thickness)->Shape{
        Shape node
        node.init(radius,sides,fill,outline,thickness)
        return node
    }
}


struct Collision{
    f32 radius
}

impl Collision{
    fn init(f32 radius){
        self->radius = radius
    }

    #[static(true)]
    fn new(f32 radius)->Collision{
        Collision node
        node.init(radius)
        return node
    }
}


struct Input{
    bool up
    bool down
    bool left
    bool right
}

impl Input{
    fn init(bool up,bool down,bool left,bool right){
        self->up    = up
        self->down  = down
        self->left  = left
        self->right = right
    }


    #[static(true)]
    fn new(bool up,bool down,bool left,bool right)->Input{
        Input node
        node.init(up,down,left,right)
        return node
    }
   
}


struct Score{
    i32 score
}

impl Score{
    fn init(i32 score){
        self->score = score
    }

    #[static(true)]
    fn new(i32 score)->Score{
        Score node
        node.init(score)
        return node
    }
    
}


struct LifeSpan{
    i32 remaining
    i32 total
}

impl LifeSpan{
    fn init(i32 remaining,i32 total){
        self->remaining = remaining
        self->total     = total
    }

    #[static(true)]
    fn new(i32 remaining,i32 total)->LifeSpan{
        LifeSpan node
        node.init(remaining,total)
        return node
    }
}




struct Entity{
   i32 id 
   String tag
   bool isAlive
   Transform *transform
   Shape *shape
   Collision *collision
   Input *input
   Score *score
   LifeSpan *lifeSpan
}



impl Entity{
    fn init(String tag,i32 id){
        self->tag     = tag
        self->id      = id
        self->isAlive = true
    }


    fn destroy(){
        self->isAlive = false
    }


    fn get_tag()->String{
        return self->tag
    }

    fn get_id()->i32{
        return self->id
    }

    fn is_alive()->bool{
        return self->isAlive 
    }
}

