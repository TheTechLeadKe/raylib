
// Raylib Types
use raylib::Key
use raylib::Color
use raylib::GREEN
use raylib::Sound
use raylib::Music
use raylib::Rectangle
use raylib::Vector2

use raylib::init_window
use raylib::close_window
use raylib::window_should_close
use raylib::begin_drawing
use raylib::end_drawing
use raylib::clear_background


use raylib::draw_rectangle
use raylib::draw_rectangle_pro


use raylib::is_key_down
use raylib::is_key_up
use raylib::is_key_pressed
use raylib::is_key_pressed_repeat
use raylib::is_key_released


use raylib::get_frame_time
use raylib::set_target_fps


use raylib::init_audio_device
use raylib::close_audio_device

use raylib::load_sound
use raylib::play_sound


use raylib::load_music_stream
use raylib::play_music_stream
use raylib::update_music_stream
use raylib::stop_music_stream
use raylib::pause_music_stream
use raylib::resume_music_stream
use raylib::unload_music_stream

const f32 MAXIMUM_CAR_SPEED = 1000
const f32 ROTATION_SPEED    = 50

foreign "C"{
    fn printf(str fmt,...)->i32
    fn cosf(f32 x)->f32
    fn sinf(f32 x)->f32
}


#[no_mangle]
fn main(i32 argc,str *argv)->i32{
    i32 width  = 1400
    i32 height = 900

    init_window(width,height,"Ariel YES")
    defer close_window()

    set_target_fps(60)

    init_audio_device()
    defer close_audio_device()

    Music music = load_music_stream("assets/sound/silence.mp3")
    defer unload_music_stream(music)

    play_music_stream(music)
    defer stop_music_stream(music)

    i32 carWidth     = 30
    i32 carHeight    = 45

    f32 carX         = (width / 2) - (carWidth / 2)
    f32 carY         = (height / 2) - (carHeight / 2)

    f32 carSpeed     = 0.0 

    i32 carDirection = -1
    f32 carRotation  = -90

    i32 carSpeedUp   = 100
    i32 carSlowDown  = 200


    while !window_should_close(){
        f32 delta = get_frame_time()

        update_music_stream(music)
        begin_drawing()
        clear_background(background_color())

        if is_key_down(Key::Up){
            carDirection = -1
            carSpeed     += carSpeedUp * delta 

            if carSpeed > MAXIMUM_CAR_SPEED{
                carSpeed = MAXIMUM_CAR_SPEED
            }

        }
        elif is_key_down(Key::Down){
            carDirection = 1
            carSpeed     -= carSpeedUp * delta 

            if carSpeed > MAXIMUM_CAR_SPEED{
                carSpeed = MAXIMUM_CAR_SPEED
            }

        }
        else{
            carSpeed += carSlowDown * delta * carDirection

            if (carDirection == -1) and (carSpeed < 0){
                carSpeed = 0
            }
            elif (carDirection == 1) and (carSpeed > 0){
                carSpeed = 0
            }
        }

        if is_key_down(Key::Left){
            carRotation -= ROTATION_SPEED * delta
        }
        elif is_key_down(Key::Right){
            carRotation += ROTATION_SPEED * delta
        }

        if carRotation >= 360{
            carRotation = 0
        }

        f32 radians = degrees_to_radians(carRotation) as f32

        f32 xMove = carSpeed * cosf(radians)
        f32 yMove = carSpeed * sinf(radians)

        carX += xMove * delta
        carY += yMove * delta


        Rectangle carRectangle = Rectangle::new(carX,carY,carHeight,carWidth)
        Vector2 carOrigin      = Vector2::new(carHeight / 2,carWidth / 2)

        draw_rectangle_pro(carRectangle,carOrigin,carRotation,car_color())

        end_drawing()
    }


    return 0
}


fn background_color()->Color{
    return Color::new(0,0,0,0)
}


fn car_color()->Color{
    return Color::new(255,158,45,255)
}

const f64 PI = 3.14159265358979323846

fn degrees_to_radians(f64 degrees)->f64{
    return ((PI * degrees) / (180 as f64)) as f64
}
